<view class="screen {{themeClass}} pad-bottom-action">
  <nav-bar title="结果" show-back plaza />
  <view class="body pad-page" style="{{layout.bodyPadStyle}}">
    <block wx:if="{{kind === 'pass'}}">
      <view class="axis">
        <ms-seal wx:if="{{drop}}" kind="yanqi" size="128" drop />
      </view>
      <view class="lines">
        <view class="type-body">未被篡改</view>
        <view class="type-body">宣誓有效</view>
        <view class="type-body">核身有效</view>
      </view>
      <fact-column rows="{{rows}}" />
      <view class="gold-slot" wx:if="{{gold}}">
        <ms-seal kind="meng" size="96" />
      </view>
    </block>

    <block wx:if="{{kind === 'expired'}}">
      <view class="axis">
        <view class="gate">
          <view class="leaf"></view>
          <view class="leaf"></view>
        </view>
      </view>
      <view class="type-h3 center">授权码已过期</view>
    </block>

    <block wx:if="{{kind === 'deny'}}">
      <view class="spacer"></view>
      <view class="type-h3 center">用户未授权</view>
    </block>

    <block wx:if="{{kind === 'grant'}}">
      <view class="spacer"></view>
      <fact-column rows="{{rows}}" />
      <view class="type-caption mono until">{{until}}</view>
      <view class="link pressable" bindtap="toLedger">已记入授权记录</view>
    </block>
  </view>
  <action-bar wx:if="{{kind === 'expired'}}" single="再核验一次" bind:single="retry" />
</view>
