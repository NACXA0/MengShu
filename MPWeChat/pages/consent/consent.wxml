<view class="screen depth-page {{themeClass}} {{phase === 'enter' || phase === 'leave' ? (phase === 'leave' ? 'leaving' : 'entering') : ''}} pad-bottom-action">
  <nav-bar title="授权" show-back plaza="{{false}}" depth bind:back="onBack" />
  <scroll-view scroll-y class="scroller pad-page" style="{{layout.bodyPadStyle}}" bindscroll="onScroll">
    <block wx:if="{{broken}}">
      <view class="type-h2">无法出示授权</view>
      <view class="type-legal miss">缺失项：{{org.missing}}</view>
    </block>
    <block wx:else>
      <view class="type-h2">{{org.name}}</view>
      <view class="mono type-legal contact">{{org.contact}}</view>
      <view class="type-body purpose">{{org.purpose}}</view>
      <view
        class="ghost-field pressable"
        wx:for="{{org.fields}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="toggle"
      >
        <view class="check {{checks[item.key] ? 'check-on' : ''}}"></view>
        <text>{{item.label}}</text>
      </view>
      <view class="type-caption">关系档案明细不在可授权范围</view>
      <view class="type-legal block">保存期限：{{org.retain}}</view>
      <view class="type-legal block">你的权利：{{org.rights}}</view>
      <view class="type-legal block">本次传输只含你勾选的公示摘要。关系档案明细不在可授权字段集合中。</view>
      <view class="ghost-field pressable" bindtap="toggle90">
        <view class="check {{days90 ? 'check-on' : ''}}"></view>
        <text>90 天内再次拉取</text>
      </view>
      <view class="type-caption demo pressable" bindtap="timeoutDemo">演示超时</view>
    </block>
  </scroll-view>
  <action-bar
    wx:if="{{!broken}}"
    left-text="拒绝"
    right-text="允许本次"
    right-fill="{{canAllow}}"
    right-disabled="{{!canAllow}}"
    bind:left="deny"
    bind:right="allow"
  />
</view>
