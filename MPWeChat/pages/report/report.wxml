<view class="screen {{themeClass}} pad-bottom-action">
  <nav-bar title="举报" show-back plaza />
  <view class="body pad-page" style="{{layout.bodyPadStyle}}">
    <view
      class="ghost-field pressable"
      wx:for="{{reasons}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="pick"
    >
      <view class="check {{picked === index ? 'check-on' : ''}}"></view>
      <text class="grow">{{item}}</text>
      <ms-seal wx:if="{{done && picked === index}}" kind="shouli" size="48" drop="{{drop}}" />
    </view>
    <view class="type-caption" wx:if="{{done}}">24 小时内处理</view>
  </view>
  <action-bar
    wx:if="{{!done}}"
    single="提交"
    single-disabled="{{picked < 0}}"
    bind:single="submit"
  />
</view>
