.wrap {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(16rpx + constant(safe-area-inset-bottom));
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 30;
  transition: transform 250ms ease, opacity 250ms ease;
}

.wrap.heavy {
  transition: transform 400ms ease, opacity 400ms ease, filter 400ms ease;
}

.wrap.out {
  transform: translateY(120%);
  opacity: 0;
  pointer-events: none;
}

.bar {
  height: 112rpx;
  border-radius: 16rpx;
  background: var(--paper);
  border: 1px solid var(--ink-qing);
  box-shadow: 0 16rpx 48rpx rgba(18, 41, 62, 0.08);
  display: flex;
  flex-direction: row;
  padding: 8rpx;
  box-sizing: border-box;
}

.item {
  flex: 1;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.lab {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--ink-zhong);
}

.on {
  background: var(--paper-attach);
}

.on .lab {
  color: var(--ink-nong);
  box-shadow: inset 0 -4rpx 0 var(--ink-nong);
}
