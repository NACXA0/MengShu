/**
 * 盟书 PactBook — 纸 / 墨 / 印
 * 字重仅 Regular / Medium。发丝线用 1px。其余尺寸用 rpx。
 */
page {
  --paper: #fafbfc;
  --paper-attach: #f7fafc;
  --paper-night: #1e2126;
  --depth-day: #12293e;
  --depth-vault: #0d1b2a;
  --depth-night: #131519;

  --ink-jiao: #12293e;
  --ink-nong: #1b3a5c;
  --ink-zhong: #4a5568;
  --ink-dan: #a0aec0;
  --ink-qing: #e2e8f0;
  --ink-night: #e8ecef;

  --seal-gold: #c9a961;
  --seal-gold-night: #d4b876;
  --seal-green: #2f855a;
  --seal-vermilion: #b93a32;
  --seal-amber: #b7791f;
  --seal-alert: #c53030;

  --type-serif: "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "Songti", serif;
  --type-sans: "Source Han Sans SC", "Noto Sans CJK SC", "PingFang SC", sans-serif;
  --type-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;

  --r-tag: 4rpx;
  --r-ctl: 8rpx;
  --r-card: 16rpx;
  --r-pill: 999rpx;

  --t-paper: 100ms;
  --t-ink: 250ms;
  --t-weight: 400ms;

  --page-pad: 64rpx;
  --tab-reserve: calc(112rpx + 16rpx + constant(safe-area-inset-bottom));
  --tab-reserve: calc(112rpx + 16rpx + env(safe-area-inset-bottom));

  background-color: var(--paper);
  color: var(--ink-nong);
  font-family: var(--type-sans);
  font-weight: 400;
  font-size: 32rpx;
  line-height: 52rpx;
}

.theme-dark {
  --paper: #1e2126;
  --paper-attach: #181b1f;
  --depth-day: #131519;
  --depth-vault: #131519;
  --ink-jiao: #e8ecef;
  --ink-nong: #e8ecef;
  --ink-zhong: #a0aec0;
  --ink-dan: #718096;
  --ink-qing: #2d3238;
  --seal-gold: #d4b876;
}

.depth-page {
  --paper: #0d1b2a;
  --paper-attach: #152238;
  --ink-jiao: #e8ecef;
  --ink-nong: #e8ecef;
  --ink-zhong: #a0aec0;
  --ink-dan: #718096;
  --ink-qing: #2c3a4a;
  --seal-gold: #d4b876;
  background-color: #0d1b2a;
}

.depth-page .btn {
  border-color: var(--ink-nong);
  color: var(--ink-nong);
}

.depth-page .btn-fill {
  background: var(--seal-gold);
  border-color: var(--seal-gold);
  color: #0d1b2a;
}

.depth-page .input-line,
.depth-page .field-line {
  border-bottom-color: var(--ink-qing);
  color: var(--ink-jiao);
}

.depth-page .ghost-field.alert,
.depth-page .alert {
  color: var(--seal-alert);
}

.theme-dark.depth-page {
  --paper: #131519;
  --paper-attach: #181b1f;
  --ink-qing: #2a2d32;
  background-color: #131519;
}

.screen {
  min-height: 100vh;
  background: var(--paper);
  color: var(--ink-nong);
  box-sizing: border-box;
}

.depth-page.entering,
.depth-page.leaving {
  background-color: #fafbfc;
}

.theme-dark.depth-page.entering,
.theme-dark.depth-page.leaving {
  background-color: #1e2126;
}

.depth-page,
.depth-page.entering,
.depth-page.leaving {
  transition: background-color 400ms ease;
}

@media (prefers-reduced-motion: reduce) {
  .depth-page,
  .depth-page.entering,
  .depth-page.leaving,
  .seal-drop,
  .tab-bar,
  .hair,
  .ink-line,
  .pressable {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

.serif {
  font-family: var(--type-serif);
  font-weight: 500;
  letter-spacing: 0.05em;
}

.mono {
  font-family: var(--type-mono);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  letter-spacing: 0;
}

.tnum {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.type-display {
  font-family: var(--type-serif);
  font-size: 68rpx;
  line-height: 88rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--ink-jiao);
}

.type-h1 {
  font-family: var(--type-serif);
  font-size: 56rpx;
  line-height: 76rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--ink-jiao);
}

.type-h2 {
  font-size: 44rpx;
  line-height: 60rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--ink-jiao);
}

.type-h3 {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 500;
  color: var(--ink-jiao);
}

.type-body {
  font-size: 32rpx;
  line-height: 52rpx;
  font-weight: 400;
  color: var(--ink-nong);
}

.type-legal {
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 400;
  color: var(--ink-nong);
}

.type-caption {
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 400;
  color: var(--ink-dan);
}

.pad-page {
  padding-left: 64rpx;
  padding-right: 64rpx;
}

.pad-bottom-tab {
  padding-bottom: calc(144rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.pad-bottom-action {
  padding-bottom: calc(128rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

.hair {
  height: 1px;
  background: var(--ink-qing);
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
  min-width: 0;
}

.pressable {
  transition: opacity 100ms ease, background-color 100ms ease, border-color 100ms ease;
}

.pressable:active {
  opacity: 0.78;
}

.shake {
  animation: shake-x 100ms ease-in-out 1;
}

@keyframes shake-x {
  0% { transform: translateX(0); }
  25% { transform: translateX(8rpx); }
  75% { transform: translateX(-8rpx); }
  100% { transform: translateX(0); }
}

.seal-drop {
  transform: scale(1);
  animation: seal-fall 400ms ease-out 1;
}

@keyframes seal-fall {
  0% { transform: scale(1.2); opacity: 0.7; }
  100% { transform: scale(1); opacity: 1; }
}

.nudge {
  animation: nudge-x 100ms ease-out 1;
}

@keyframes nudge-x {
  0% { transform: translateX(0); }
  40% { transform: translateX(4rpx); }
  100% { transform: translateX(0); }
}

.btn {
  height: 96rpx;
  border-radius: 8rpx;
  border: 1px solid var(--ink-nong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  color: var(--ink-nong);
  background: transparent;
  box-sizing: border-box;
}

.btn-fill {
  background: var(--ink-nong);
  color: var(--paper);
}

.btn-disabled {
  opacity: 0.4;
}

.btn-alert {
  color: var(--seal-alert);
  border-color: var(--seal-alert);
}

.pill {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 1px solid var(--ink-nong);
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--ink-nong);
}

.input-line {
  position: relative;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1px solid var(--ink-qing);
}

.input-line.focus {
  border-bottom-width: 2px;
  border-bottom-color: var(--ink-nong);
}

.corners {
  pointer-events: none;
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  top: 8rpx;
  bottom: 8rpx;
}

.corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-color: var(--ink-nong);
  border-style: solid;
  border-width: 0;
}

.corner-tl { top: 0; left: 0; border-top-width: 1.5px; border-left-width: 1.5px; }
.corner-tr { top: 0; right: 0; border-top-width: 1.5px; border-right-width: 1.5px; }
.corner-bl { bottom: 0; left: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
.corner-br { bottom: 0; right: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }

.action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 32rpx calc(8rpx + constant(safe-area-inset-bottom));
  padding: 8rpx 32rpx calc(8rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  box-sizing: border-box;
}

.action-tray {
  border-radius: 16rpx;
  padding: 8rpx;
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.ghost-field {
  height: 96rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.check {
  width: 32rpx;
  height: 32rpx;
  border: 1px solid var(--ink-nong);
  border-radius: 4rpx;
  margin-right: 24rpx;
  box-sizing: border-box;
}

.check-on {
  background: var(--ink-nong);
}

.ad-card {
  margin-top: 96rpx;
  background: var(--paper-attach);
  border: 1px dashed var(--ink-dan);
  border-radius: 16rpx;
  padding: 32rpx;
  position: relative;
}

.ad-tag {
  position: absolute;
  left: 0;
  top: 0;
  background: var(--ink-zhong);
  color: #fafbfc;
  font-size: 24rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
}

.indent-2 {
  text-indent: 2em;
}

.sign-off {
  text-align: right;
  color: var(--ink-zhong);
  font-family: var(--type-serif);
  font-size: 24rpx;
  line-height: 36rpx;
  margin-top: 16rpx;
}
