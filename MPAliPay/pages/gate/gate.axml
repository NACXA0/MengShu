<view class="screen {{themeClass}}">
  <view class="body pad-page" style="{{layout.bodyPadStyle}}">
    <view class="type-h1">盟书</view>
    <view class="type-caption lead">支付宝小程序 · 云开发</view>
    <view class="ghost-field pressable" onTap="toggleAdult">
      <view class="check {{adult ? 'check-on' : ''}}"></view>
      <text class="grow">我已满 18 周岁</text>
    </view>
    <view class="ghost-field pressable" onTap="toggleRefuse">
      <view class="check {{refuseExisting ? 'check-on' : ''}}"></view>
      <text class="grow">演示：已绑定则拒绝（US-F9）</text>
    </view>
    <view class="type-caption note">{{note}}</view>
    <view class="type-legal err" a:if="{{message}}">{{message}}</view>
    <view class="action-tray enter">
      <view class="btn btn-fill grow pressable {{busy ? 'btn-disabled' : ''}}" onTap="enter">静默授权进入</view>
    </view>
  </view>
</view>
