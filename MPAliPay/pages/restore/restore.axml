<view class="screen depth-page {{themeClass}} pad-bottom-action">
  <view class="body pad-page">
    <view class="type-caption">本地模拟：助记词 + 新口令</view>
    <textarea class="mono area" value="{{mnemonic}}" placeholder="助记词" onInput="onMnemonic" />
    <input class="mono field-line" password value="{{pass}}" placeholder="新口令" onInput="onPass" />
    <view class="type-legal err" a:if="{{message}}">{{message}}</view>
  </view>
  <action-bar single="恢复" onSingle="restore" />
</view>
