.scroller {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: 200rpx;
}

.contact {
  margin: 16rpx 0 32rpx;
}

.purpose {
  margin-bottom: 32rpx;
}

.block {
  margin-top: 32rpx;
}

.miss {
  margin-top: 32rpx;
}

.allow90 {
  margin-top: 48rpx;
  text-align: center;
  text-decoration: underline;
  color: var(--ink-zhong);
}

.allow90.dim {
  opacity: 0.4;
}

.demo {
  margin: 32rpx 0 48rpx;
  text-align: center;
}
