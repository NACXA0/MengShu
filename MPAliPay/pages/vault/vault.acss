.note {
  margin-bottom: 24rpx;
}

.field-line {
  height: 88rpx;
  margin: 16rpx 0 24rpx;
  border-bottom: 1px solid var(--ink-qing);
  font-size: 28rpx;
  color: var(--ink-jiao);
}

.err {
  color: var(--seal-alert);
  margin-bottom: 16rpx;
}

.group {
  margin-bottom: 32rpx;
}

.row {
  display: flex;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.empty-rings {
  position: relative;
  width: 120rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.ring {
  position: absolute;
  top: 0;
  left: 8rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  border: 1.5px solid var(--seal-gold);
  opacity: 0.7;
  box-sizing: border-box;
}

.ring-b {
  left: auto;
  right: 8rpx;
  opacity: 0.45;
}

.empty-hint {
  margin-top: 8rpx;
  text-align: center;
}
