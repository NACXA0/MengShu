<view class="screen {{themeClass}}">
  <view class="capsule-buttons" style="{{layout.capsuleButtonsStyle}}">
    <view class="capsule-btn pressable" style="width:{{layout.gearSizeRpx}}rpx;height:{{layout.gearSizeRpx}}rpx;" onTap="onScan">
      <ms-icon name="scan" size="{{layout.gearSizeRpx}}" />
    </view>
    <view class="capsule-btn pressable" style="width:{{layout.gearSizeRpx}}rpx;height:{{layout.gearSizeRpx}}rpx;" onTap="openSettings">
      <ms-icon name="gear" size="{{layout.gearSizeRpx}}" />
    </view>
  </view>
  <view class="body pad-page" style="{{layout.barePadStyle}}">
    <view class="type-caption note">{{note}}</view>

    <view class="group" a:if="{{!unlocked}}">
      <view class="zone-row">
        <text class="zone-chip">Vault</text>
      </view>
      <view class="type-body">{{hasLock ? '输入口令解锁' : '设置口令（本地模拟）'}}</view>
      <input class="mono field-line" password value="{{pass}}" placeholder="口令" onInput="onPassInput" />
      <view class="type-legal err" a:if="{{message}}">{{message}}</view>
      <view class="action-tray">
        <view class="btn btn-fill grow pressable" onTap="onLockAction">{{hasLock ? '解锁' : '设置并打开'}}</view>
      </view>
    </view>

    <block a:else>
      <view class="overview pressable" onTap="copyRoot">
        <view class="overview-head">
          <text class="type-body overview-title">我的档案</text>
        </view>
        <view class="type-caption">{{overview.lastLabel}}</view>
      </view>

      <view class="type-caption sect">关系记录</view>
      <view class="group">
        <view
          class="ghost-field pressable"
          a:for="{{relations}}"
          a:key="id"
          data-id="{{item.id}}"
          onTap="openSign"
        >
          <view class="grow">
            <view class="type-body">{{item.title}}</view>
            <view class="type-caption">{{item.displayLabel}}{{item.anchoredLabel ? ' · ' + item.anchoredLabel : ''}}</view>
          </view>
        </view>
        <view class="empty" a:if="{{!relations.length}}">
          <view class="empty-rings" aria-hidden="true">
            <view class="ring"></view>
            <view class="ring ring-b"></view>
          </view>
          <view class="type-caption">尚无关系档案</view>
          <view class="type-caption empty-hint">发起关系并双签后，记录会留在本机保险库</view>
        </view>
      </view>

      <view class="plaza-card pressable" onTap="openPlaza">
        <block a:if="{{plaza.on}}">
          <view class="type-body">我的公示名片 · 挂出中</view>
          <view class="type-caption">存证 {{plaza.band}} 段 · {{plaza.publicId}}</view>
          <view class="type-caption more">管理 / 一键撤下 →</view>
        </block>
        <block a:else>
          <view class="type-body">公示名片</view>
          <view class="type-caption">自愿挂出、随时撤下。开启我的公示 →</view>
        </block>
      </view>
      <view class="type-legal err" a:if="{{message}}">{{message}}</view>
    </block>
  </view>
</view>
