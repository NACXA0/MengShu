.vault {
  background-color: #0d1b2a;
}

.theme-dark.vault {
  background-color: #131519;
}

.stage {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.door {
  width: 280rpx;
  height: 360rpx;
  display: flex;
  flex-direction: row;
  border: 1.5px solid #a0aec0;
}

.leaf {
  flex: 1;
  border-right: 1px solid #a0aec0;
}

.leaf:last-child {
  border-right: none;
}

.cap {
  margin-top: 48rpx;
  color: #a0aec0;
}
