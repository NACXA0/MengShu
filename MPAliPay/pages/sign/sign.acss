.status {
  margin: 12rpx 0 24rpx;
}

.err {
  color: var(--seal-alert);
  margin: 16rpx 0;
}

.ritual {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 64rpx;
}

.seal-slot {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 250ms ease;
}

.seal-slot.visible {
  opacity: 1;
}

.ritual-label {
  margin-top: 32rpx;
  color: var(--seal-gold);
}

.digest {
  margin-top: 24rpx;
  text-align: center;
  word-break: break-all;
  min-height: 88rpx;
  color: var(--ink-zhong);
}
