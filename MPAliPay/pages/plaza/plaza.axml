<view class="screen {{themeClass}} pad-bottom-action">
  <nav-bar title="公开页" showBack="{{true}}" report="{{true}}" onReport="onReport" />
  <view class="body pad-page" style="{{layout.bodyPadStyle}}" a:if="{{profile && !profile.withdrawn}}">
    <view class="head">
      <view class="name-block">
        <view class="type-h1">{{profile.name}}</view>
        <view class="mono public-id">{{profile.publicId}}</view>
      </view>
      <view class="seal-slot pressable" onTap="onSeal">
        <view a:if="{{pending}}" class="empty-ring"></view>
        <ms-seal a:else kind="{{sealKind}}" size="{{96}}" />
      </view>
    </view>
    <view class="block">
      <fact-column rows="{{rows}}" />
    </view>
    <view class="block">
      <statement-card statements="{{profile.statements}}" />
    </view>
    <view class="type-caption div-line">{{profile.dividend}}</view>
    <view class="ad-card">
      <view class="ad-tag">广告</view>
      <view class="type-legal">婚恋服务机构可申请查询已公示字段。</view>
    </view>
  </view>
  <view class="body pad-page withdrawn" style="{{layout.bodyPadStyle}}" a:elif="{{profile && profile.withdrawn}}">
    <view class="gate">
      <view class="leaf"></view>
      <view class="leaf"></view>
    </view>
    <view class="type-h3">公示已撤下</view>
  </view>
  <view class="share" a:if="{{profile && !profile.withdrawn}}">
    <view class="btn grow pressable" onTap="onCopy">复制链接</view>
  </view>
</view>
