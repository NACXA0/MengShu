.body {
  padding-top: 48rpx;
}

.finder {
  width: 336rpx;
  height: 336rpx;
  margin: 48rpx auto 32rpx;
  position: relative;
}

.finder .corner {
  width: 48rpx;
  height: 48rpx;
  border-color: var(--ink-nong);
}

.hint {
  text-align: center;
  margin-bottom: 24rpx;
}

.field {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--ink-jiao);
}

.go {
  font-size: 32rpx;
  color: var(--ink-nong);
  padding: 0 8rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.logs {
  margin-top: 48rpx;
}

.log {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.time {
  font-family: var(--type-serif);
  font-size: 24rpx;
  color: var(--ink-zhong);
}
