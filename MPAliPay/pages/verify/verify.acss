.body {
  padding-top: 48rpx;
}

.finder {
  width: 336rpx;
  height: 336rpx;
  margin: 48rpx auto 32rpx;
  position: relative;
}

.finder .corner {
  width: 48rpx;
  height: 48rpx;
  border-color: var(--ink-nong);
}

.hint {
  text-align: center;
  margin-bottom: 24rpx;
}

.field {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--ink-jiao);
}

.go {
  font-size: 32rpx;
  color: var(--ink-nong);
  padding: 0 8rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.logs {
  margin-top: 48rpx;
}

.log {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.time {
  font-family: var(--type-serif);
  font-size: 24rpx;
  color: var(--ink-zhong);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 24rpx;
}

.empty-rings {
  position: relative;
  width: 120rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.ring {
  position: absolute;
  top: 0;
  left: 8rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  border: 1.5px solid var(--ink-nong);
  opacity: 0.55;
  box-sizing: border-box;
}

.ring-b {
  left: auto;
  right: 8rpx;
  opacity: 0.35;
}

.empty-hint {
  margin-top: 8rpx;
  text-align: center;
}
