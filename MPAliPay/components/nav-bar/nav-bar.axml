<view class="nav {{scrolled ? 'scrolled' : ''}} {{depth ? 'depth' : ''}}" style="{{layout.navPadStyle}}">
  <view
    a:if="{{showBack}}"
    class="back"
    style="{{layout.backStyle}}"
    aria-role="button"
    aria-label="返回"
    onTap="onBackTap"
  >
    <ms-icon name="caret-left" size="{{48}}" tone="{{tone}}" />
  </view>
  <view class="title serif">{{title}}</view>
  <view
    class="right"
    a:if="{{report}}"
    aria-role="button"
    aria-label="举报"
    onTap="onReportTap"
  >举报</view>
  <view class="pill {{zone === 'vault' ? 'pill-vault' : 'pill-plaza'}}" a:elif="{{zone}}">{{zoneLabel}}</view>
</view>
